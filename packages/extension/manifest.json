{
  "manifest_version": 3,
  "name": "session-radar",
  "version": "0.0.5",
  "description": "Read-only collector: reports metadata-only claude.ai and chatgpt.com session inventory/state to your local session-radar daemon.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:4747/*"
  ],
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ]
}
